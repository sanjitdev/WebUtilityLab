# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE — `.vscode/` is excluded except for the two files we intentionally
# track: `settings.json` (project-level editor settings) and
# `extensions.json` (recommended extension list). The trailing `/` on
# `.vscode/` plus the explicit re-include patterns is the only way Git
# will track files in nested subdirectories of an otherwise-ignored
# directory; bare `*` will silently drop subdirs.
.idea/
*.iml
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# Node / build
node_modules/
dist/
build/
*.log

# Environment
.env
.env.*
!.env.example

# Test / coverage
coverage/
.nyc_output/

# TypeScript build output
*.tsbuildinfo

# OS-generated temp
tmp/
temp/

