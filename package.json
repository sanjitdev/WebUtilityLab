{
  "name": "webutilitylab",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first, browser-based utility toolbox. CSV Rescue MVP.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-cleanup.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "audit:privacy": "node scripts/audit-privacy.mjs",
    "audit:behavior": "node scripts/audit-behavior.mjs",
    "audit:all": "npm run audit:privacy && npm run audit:behavior",
    "check:deps": "node scripts/check-deps.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:telemetry": "node scripts/check-telemetry.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.10.5",
    "@vitest/ui": "3.2.7",
    "playwright": "1.62.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
